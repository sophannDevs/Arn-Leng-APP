# Copy to .env at the repo root: `cp .env.example .env`
# The values below match docker-compose.yml, so local development works as-is.
# Never commit .env or real credentials.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────
# App connections. The default is the Docker database. For Supabase, use the transaction-mode
# pooler (Connect → ORMs): postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
# URL-encode special characters in the password (@ → %40, # → %23, $ → %24, ! → %21).
DATABASE_URL=postgres://inkline:inkline@localhost:5432/inkline
# Migrations and `pnpm db:seed`; optional, defaults to DATABASE_URL. For Supabase, the
# session-mode pooler: same URL as above but port 5432.
# DIRECT_URL=
# Host port Docker publishes PostgreSQL on. Change it (and the port in DATABASE_URL) if another
# PostgreSQL already listens on 5432, e.g. a Homebrew install.
POSTGRES_PORT=5432

# ── Redis (cache, rate limits, BullMQ queues) ────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO locally, Cloudflare R2 in production) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=inkline
S3_SECRET_ACCESS_KEY=inkline-secret
# Episode pages (private, served through short-lived URLs)
S3_BUCKET_PRIVATE=inkline-private
# Covers, thumbnails and avatars (public, behind the CDN)
S3_BUCKET_PUBLIC=inkline-public

# ── Worker ───────────────────────────────────────────
# Jobs processed in parallel per queue
WORKER_CONCURRENCY=2

# Later phases add: Better Auth + OAuth keys and Turnstile (Phase 2), Resend (Phase 2),
# PayWay sandbox credentials and the payment-token encryption key (Phase 8),
# Sentry and PostHog (Phase 11).
