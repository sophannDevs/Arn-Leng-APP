# Copy to .env at the repo root: `cp .env.example .env`
# The values below match docker-compose.yml, so local development works as-is.
# Never commit .env or real credentials.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────
# App connections. The default is the Docker database. For Supabase, use the transaction-mode
# pooler (Connect → ORMs): postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
# URL-encode special characters in the password (@ → %40, # → %23, $ → %24, ! → %21).
DATABASE_URL=postgres://inkline:inkline@localhost:5432/inkline
# Migrations and `pnpm db:seed`; optional, defaults to DATABASE_URL. For Supabase, the
# session-mode pooler: same URL as above but port 5432.
# DIRECT_URL=
# Host port Docker publishes PostgreSQL on. Change it (and the port in DATABASE_URL) if another
# PostgreSQL already listens on 5432, e.g. a Homebrew install.
POSTGRES_PORT=5432

# ── Auth (Better Auth) ───────────────────────────────
# Signs session cookies and encrypts 2FA secrets. Generate your own with: openssl rand -base64 32
# Rotating it signs everyone out and breaks existing 2FA. Production must NOT use this placeholder.
BETTER_AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars

# Cloudflare Turnstile on sign-up and password reset. These are Cloudflare's published test keys
# (the challenge always passes); production needs real keys. Leave both empty to skip the challenge.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email. Without RESEND_API_KEY, emails are printed to the web server's console (and appended to
# .dev-mail/outbox.jsonl, which the end-to-end tests read). Production requires it.
RESEND_API_KEY=
EMAIL_FROM=Inkline <no-reply@inkline.com>

# Social login: a button appears only when both values of a provider are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Redis (cache, rate limits, BullMQ queues) ────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO locally, Cloudflare R2 in production) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=inkline
S3_SECRET_ACCESS_KEY=inkline-secret
# Episode pages (private, served through short-lived URLs)
S3_BUCKET_PRIVATE=inkline-private
# Covers, thumbnails and avatars (public, behind the CDN)
S3_BUCKET_PUBLIC=inkline-public

# ── Worker ───────────────────────────────────────────
# Jobs processed in parallel per queue
WORKER_CONCURRENCY=2

# Later phases add: PayWay sandbox credentials and the payment-token encryption key (Phase 8),
# Sentry and PostHog (Phase 11).
