{
  "name": "inkline",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d --wait postgres redis minio && docker compose run --rm minio-init",
    "services:down": "docker compose down",
    "db:generate": "pnpm --filter @inkline/db db:generate",
    "db:migrate": "pnpm --filter @inkline/db db:migrate",
    "db:seed": "pnpm --filter @inkline/db db:seed",
    "db:studio": "pnpm --filter @inkline/db db:studio",
    "example-job": "pnpm --filter @inkline/worker enqueue:example"
  },
  "devDependencies": {
    "@inkline/config": "workspace:*",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
